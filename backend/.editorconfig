# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 4

[*.xml]
indent_size = 4

[*.sql]
indent_size = 4

[*.env]
indent_size = 2

[*.{js,mjs,cjs,ts,tsx}]
indent_size = 2

[*.{css,scss,sass}]
indent_size = 2

[*.{html,blade.php}]
indent_size = 4

[*.php]
indent_size = 4

[Makefile]
indent_style = tab

[Dockerfile]
indent_style = space
indent_size = 4

[{docker-compose.yml,docker-compose.yaml}]
indent_size = 2