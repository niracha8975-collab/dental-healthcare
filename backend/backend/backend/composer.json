{
    "name": "dental-healthcare/backend",

    "type": "project",

    "description": "Dental Healthcare Management System for Health Promoting Hospital",

    "require": {

        "php": "^8.3",

        "laravel/framework": "^12.0",

        "laravel/sanctum": "^4.0",

        "laravel/fortify": "^1.0",

        "spatie/laravel-permission": "^6.0",

        "laravel/reverb": "^1.0",

        "firebase/php-jwt": "^6.0"

    },


    "require-dev": {

        "fakerphp/faker": "^1.23",

        "laravel/pint": "^1.0",

        "laravel/sail": "^1.0",

        "mockery/mockery": "^1.6",

        "phpunit/phpunit": "^11.0"

    },


    "autoload": {

        "psr-4": {

            "App\\": "app/",

            "Database\\Factories\\": "database/factories/",

            "Database\\Seeders\\": "database/seeders/"

        }

    },


    "autoload-dev": {

        "psr-4": {

            "Tests\\": "tests/"

        }

    },


    "scripts": {

        "post-autoload-dump": [

            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",

            "@php artisan package:discover"

        ],


        "post-install-cmd": [

            "@php artisan storage:link"

        ],


        "dev": [

            "php artisan serve"

        ],


        "test": [

            "php artisan test"

        ]

    },


    "extra": {

        "laravel": {

            "dont-discover": []

        }

    },


    "config": {

        "optimize-autoloader": true,

        "preferred-install": "dist",

        "sort-packages": true

    }


}